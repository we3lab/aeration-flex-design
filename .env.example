# Copy to .env (gitignored) and edit. Every variable is optional; shell environment variables take precedence.

# Where per-day solves are cached. Default: aeration_flexibility/output_data/intermediate
# AERATION_INTERMEDIATE_DIR=/path/to/large/disk/aeration-flexibility-cache

# LP solver: gurobi (default, needs a license) or highs (open source, bundled with SciPy, slower)
# AERATION_SOLVER=highs

# Gurobi reads its own license location; only needed if the license is not in a default location
# GRB_LICENSE_FILE=/path/to/gurobi.lic
